        {"from": "ss-med-ratking-igc-first-generator:enter-igc", "to": "ss-vox-med-hospital-basement-back-rooms-1", "kind": "send", "event": "generator-interact", "conf": "CONFIRMED"},
        {"from": "gen-med-hospital-first-1", "to": "ss-med-ratking-igc-first-generator", "kind": "broadcast", "event": "pull-attempt-result", "conf": "CONFIRMED"},
