{
  "schema": {
    "description": "Power -> world event graph for TLOU2R PC 1.6 DC scripts. Nodes are state scripts (optionally :state), native systems or world objects; edges are the mechanism that carries the signal.",
    "edge_kinds": {
      "send": "send-event(event, target, args...) - DC call, CONFIRMED in source",
      "broadcast": "broadcast-event(event, args...) - DC call, CONFIRMED in source",
      "native-event": "event delivered by the engine, not sent by any DC script (e.g. player-requested-interact)",
      "task": "task-complete!(node, sub) in sender; receivers react to the engine-broadcast task-complete event and test task-active?/task-complete?",
      "remote-var": "set-boolean/get-boolean on another script instance's declared variable (no event)",
      "svar": "save variable set-svar/get-svar (persistent)",
      "native-call": "direct call of a native function on a world object (door-open, interactable-enable, set-light-process-intensity ...)",
      "light-event": "turn-on-light/turn-off-light (DC wrappers in script-user-funcs-impl.bin) send turn-on / turn-on-instantly / turn-off to a light entity; turn-on-instantly has 0 DC handlers -> native light entity"
    },
    "confidence_legend": ["CONFIRMED", "HIGH CONFIDENCE", "INFERRED", "UNKNOWN"]
  },
  "shared_component": {
    "id": "ss-motor-start-minigame",
    "file": "ss-t2/ss-motor-start-minigame.bin",
    "attached_to": "the generator / outboard-motor object itself (events are sent to the object name, e.g. obj-pat-library-generator-1)",
    "inputs": {
      "start-motor-minigame": "arg0 optional impulse d-array symbol; default motor-minigame-default-impulse-levels",
      "pull-attempt": "sent by the level script every frame joypad-command-active?(minigame-interact, 6) is true",
      "exit-minigame": "level script on stick-pressed-down?(move,0.30) or minigame-exit",
      "motor-minigame-play-running-idle": "level script after success (only ss-pat-generator-start sends it)",
      "motor-minigame-turn-off-power": "0 senders in DC"
    },
    "outputs": {
      "pull-attempt-result": "broadcast, arg0 int: -1 input ignored, 0 fail, 1 successful pull, 2 successful pull at max count",
      "motor-minigame-success": "broadcast, arg0 = target object; only handler is the script's own alt-hud state",
      "success/failed": "send to HUD widget w-power (ss-hud2-motor-minigame) which replies hud-anim-complete"
    }
  },
  "examples": [
    {
      "id": "patrol-jackson-library",
      "level": "Patrol (Jackson) - library basement generator",
      "nodes": [
        {"id": "native-interact", "kind": "native", "label": "native interactable system"},
        {"id": "ss-pat-generator-start", "kind": "level-script", "file": "ss-patrol/ss-pat-generator-start.bin"},
        {"id": "obj-pat-library-generator-1", "kind": "object+script", "script": "ss-motor-start-minigame"},
        {"id": "ss-pat-library-bed-area-dina-1", "kind": "npc-script", "file": "ss-patrol/ss-pat-library-bed-area-dina.bin"},
        {"id": "ss-vox-pat-library-generator-1", "kind": "vo-script"},
        {"id": "door-pat-firefly-symbol-1", "kind": "native door"},
        {"id": "library-lights", "kind": "lights", "members": ["rt-stairway-generator-light-1", "rt-lower-uplight-a-1", "rt-lower-uplight-b-1", "rt-generator-led-1", "rt-heater-1", "rt-workbench-a/b/c-1"]},
        {"id": "workbench-68", "kind": "workbench script instance"},
        {"id": "task:patrol/pat-library-generator", "kind": "task"}
      ],
      "edges": [
        {"from": "native-interact", "to": "ss-pat-generator-start:wait-for-events", "kind": "native-event", "event": "player-requested-interact", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:move-to-entry", "to": "ss-pat-library-bed-area-dina-1", "kind": "send", "event": "interacted-with-generator", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:enter-igc", "to": "obj-pat-library-generator-1", "kind": "send", "event": "start-motor-minigame", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:idle-igc", "to": "obj-pat-library-generator-1", "kind": "send", "event": "pull-attempt", "conf": "CONFIRMED"},
        {"from": "obj-pat-library-generator-1", "to": "ss-pat-generator-start", "kind": "broadcast", "event": "pull-attempt-result", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:pull-cord-fail", "to": "ss-vox-pat-library-generator-1", "kind": "send", "event": "vox-pat-generator-fail", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:pull-cord", "to": "library-lights", "kind": "light-event", "event": "sputter flicker (wait-pat-light-flicker)", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:power-on", "to": "obj-pat-library-generator-1", "kind": "send", "event": "motor-minigame-play-running-idle", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:power-on", "to": "ss-pat-library-bed-area-dina-1", "kind": "send", "event": "block-workbench-door", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:power-on", "to": "door-pat-firefly-symbol-1", "kind": "native-call", "call": "door-open(door-pat-firefly-symbol-1, 1)", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:power-on", "to": "library-lights", "kind": "light-event", "call": "pat-library-turn-on-generator-related-lights() + turn-on-light(rt-workbench-*)", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:power-on", "to": "workbench-68", "kind": "remote-var", "call": "set-boolean(light-on?, 1, workbench-68); interactable-enable(workbench-68)", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:power-on", "to": "task:patrol/pat-library-generator", "kind": "task", "call": "task-complete!(patrol, pat-library-generator)", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:power-on", "to": "ss-vox-pat-library-generator-1", "kind": "send", "event": "vox-first-workbench", "conf": "CONFIRMED"},
        {"from": "ss-pat-generator-start:exit-igc", "to": "ss-pat-library-bed-area-dina-1", "kind": "send", "event": "player-exited-generator", "conf": "CONFIRMED"}
      ],
      "persistence": "task-check -> already-complete replays door-open + lights when task-complete?(patrol, pat-library-generator) (CONFIRMED)"
    },
    {
      "id": "hospital-basement",
