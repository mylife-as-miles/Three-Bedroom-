{
  "_about": "State table for ss-t2/ss-workbench.bin (world script) and ss-hud2/ss-menu2-workbench.bin (HUD page script). Evidence: dconstruct .dcpl of each file. anim_state = workbench-weapon-def field written to *curr-workbench-state*.",
  "ss-workbench": {
    "initialize":      {"anim_state": null, "camera": null, "exits": {"unavailable": "all-weapons-acquired empty", "wait-for-player": "end of setup"}, "events": ["turn-on-light"]},
    "wait-for-player": {"anim_state": null, "exits": {"trap-mode": "player-requested-interact && trap-mode-enabled", "workbench-enter": "player-requested-interact", "unavailable": "every 15f: tension-mode-is?(3) && any enemy aware; item-removed && no weapons", "initialize": "level set t2-workbench-shared unloaded"}, "events": ["item-removed", "item-given", "player-found-workbench-timer", "workbench-trap-mode-enable", "workbench-trap-mode-disable", "player-requested-interact", "turn-on-light", "turn-off-light"]},
    "unavailable":     {"anim_state": null, "exits": {"wait-for-player": "every 15f: weapons>0 && enabled && !tension 3 && not carrying && (rogue: nearest enemy > 7m)"}, "events": ["item-given"]},
    "trap-mode":       {"anim_state": null, "exits": {"wait-for-player": "workbench-trap-mode-disable"}, "events": ["workbench-show-menu", "workbench-hide-menu", "workbench-trap-mode-disable"], "note": "external IGC (ss-nor-ellie-alone-igc-workbench) owns animation; world script only spawns weapons + pushes/pops the page"},
    "workbench-enter": {"anim_state": "0x060 enter (or 0x1B8[light-type] if lights off)", "camera": "spawn-camera + camera-enable-animated-with-id(workbench-enter, 1.5)", "exits": {"workbench-idle": "enter anim done", "workbench-put-previous-weapon-in-bag": "menu selection != animating weapon (after enter) or changed-currently-selected-weapon after phase 0x54", "workbench-disassemble-weapon": "enter-upgrade-menu after phase 0x54"}, "sends": ["broadcast workbench-enter-started", "broadcast workbench-entered"], "tracks": ["screen-effects", "main", "weapon-partial-fade-out", "hide-health-hud", "hud", "swap-backpack", "attach-weapon", "lights", "lights-render-settings", "flashlight", "hide-backpack-weapons", "script-lambda", "backpack-detach"]},
    "workbench-idle":  {"anim_state": "0x0A8 idle (0x0B8 if 0x0B0 lambda true)", "camera": "animated-stick on l_hand_prop (set at enter end)", "exits": {"inspect-weapon": "inspect-weapon event / go-to-inspect flag", "workbench-put-previous-weapon-in-bag": "menu selection changed (polled) / queued upgrade weapon differs", "workbench-disassemble-weapon": "enter-upgrade-menu / anim-queue-state==2 / upgrade-queue non-empty", "workbench-exit": "workbench-menu-exit / exit-queued / combat"}},
    "workbench-idle-weapon-on-table": {"anim_state": "0x0C0 (or owned upgrade-def 0x00)", "camera": "animated-stick", "exits": {"apply-upgrade": "upgrade-queue non-empty", "workbench-assemble-weapon": "exit-upgrade-menu / changed weapon / workbench-menu-exit / inspect-weapon / combat"}},
    "workbench-idle-hand-in-bag": {"anim_state": "*<char>-workbench-player-character* hand-in-bag idle", "exits": {"workbench-pullout-weapon-from-bag": ">0.5 s since last weapon change", "workbench-exit": "workbench-menu-exit / combat"}},
    "apply-upgrade":   {"anim_state": "upgrade-def 0x18 (combination override via 0x50) else 0x198", "camera": "camera-enable-animated-with-id(apply-upgrade, 0.5)", "exits": {"workbench-idle": "apply anim done (after menu-fade-in)", "workbench-assemble-weapon": "queued weapon differs", "workbench-disassemble-weapon": "enter-upgrade-menu inside abort range", "workbench-put-previous-weapon-in-bag": "changed weapon inside abort range", "inspect-weapon": "inspect-weapon inside abort range", "workbench-exit": "workbench-menu-exit inside abort range / combat"}, "sends": ["send menu-fade-in -> menu widget"], "end": "pop upgrade-queue/weapon-queue head; player-weapon-upgrade-update-trophy-stats"},
    "inspect-weapon":  {"anim_state": "idle 0x0A8 anims played directly", "camera": "player-investigate-object + player-investigate-set-camera-indices(pan cam)", "exits": {"workbench-idle": "workbench-menu-exit-inspect(false) / combat", "workbench-disassemble-weapon": "workbench-menu-exit-inspect(true)"}},
    "workbench-pullout-weapon-from-bag": {"anim_state": "0x100 (0x128 if 0x120 lambda)", "camera": "camera-enable-animated-with-id(workbench-pullout-weapon-from-bag, 0.5)", "exits": {"workbench-idle": "anim done", "workbench-exit": "queued weapon had no def (fallback) / menu-exit in abort range / combat", "workbench-disassemble-weapon": "anim-queue-state==2 in range 0x108", "workbench-put-previous-weapon-in-bag": "changed weapon in range 0x108 (inverse phase)"}},
    "workbench-put-previous-weapon-in-bag": {"anim_state": "0xD0 (0xF8 if 0xF0 lambda)", "camera": "camera-enable-animated-with-id(workbench-put-previous-weapon-in-bag, 0.5)", "exits": {"workbench-idle-hand-in-bag": "anim done", "workbench-pullout-weapon-from-bag": "exit-queued (re-draw queued weapon then leave)"}},
    "workbench-disassemble-weapon": {"anim_state": "0x160 if 0x158 lambda else owned-upgrade-def 0x10 else 0x130", "camera": "camera-fade-out-animated-stick + camera-enable-animated-with-id(workbench-disassemble-weapon, 0.5)", "exits": {"workbench-idle-weapon-on-table": "anim done", "workbench-assemble-weapon": "changed weapon / exit-upgrade-menu / workbench-menu-exit in range 0x138 (inverse phase) / combat"}, "sends": ["send show-upgrade-screen at phase 0x150 (0x168 alt)"], "end": "maybe consume one round: set-player-weapon-clip-ammo"},
    "workbench-assemble-weapon": {"anim_state": "owned-upgrade-def 0x08 else 0x170", "camera": "camera-enable-animated-with-id(workbench-assemble-weapon, 0.5)", "exits": {"workbench-idle": "anim done", "workbench-put-previous-weapon-in-bag": "selection differs at end / changed weapon after phase 0x190", "workbench-exit": "workbench-menu-exit after phase 0x190 / combat", "workbench-disassemble-weapon": "enter-upgrade-menu in range 0x178"}, "sends": ["send hide-upgrade-screen at phase 0x194"]},
    "workbench-exit":  {"anim_state": "0x088 exit (or 0x1C0[light-type] if lights on)", "camera": "camera-enable-animated-with-id(workbench-exit, 0.5) then camera-fade-out-auto-gen(workbench-exit, 2.0, 5.0, tag dist-camera-remap-name)", "exits": {"wait-for-player": "end"}, "sends": ["broadcast workbench-exit-started", "broadcast workbench-exited"], "tracks": ["main", "disable-auto-reload", "swap-backpack (disabled: if(0))", "lights", "lights-render-settings", "flashlight", "show-backpack-weapons", "set-weapon-overlay", "script-lambda", "ammo"]},
    "--all--": {"events": {"enter-upgrade-menu": "set anim-queue-state=2 when arriving during a transitional state", "apply-upgrade-event": "darray-append upgrade-queue(arg0), weapon-queue(arg1)", "changed-currently-selected-weapon": "time-weapon-changed = now", "inspect-weapon": "toggle go-to-inspect-weapon", "workbench-menu-exit-inspect": "clear go-to-inspect-weapon"}},
    "--script--": {"end": "kill-entity-if-spawned(tools-obj)"}
  },
  "ss-menu2-workbench": {
    "initial-setup": {"exits": {"setup-for-weapon-selection": "widgets resolved"}},
    "setup-for-weapon-selection": {"exits": {"weapon-selection": "after currently-selected-weapon written by world script"}},
    "weapon-selection": {"input": ["workbench-menu-select", "workbench-menu-exit", "workbench-menu-inspect-toggle"], "sends": ["changed-currently-selected-weapon(weapon) on focus change", "workbench-menu-exit", "inspect-weapon"], "exits": {"transition-to-upgrades": "select && weapon has workbench upgrade map", "dormant": "exit", "inspect-weapon": "inspect toggle"}},
    "dormant": {"sends": ["workbench-menu-exit every 30 frames (retry until page popped)"]},
    "transition-to-upgrades": {"sends": ["enter-upgrade-menu", "pass-page-path -> upgrades page"], "waits": "show-upgrade-screen? == 1 (set by world event show-upgrade-screen)", "exits": {"upgrade-selection": "page pushed"}},
    "transition-to-weapons": {"waits": "show-upgrade-screen? == 0 (set by hide-upgrade-screen)", "exits": {"setup-for-weapon-selection": "done"}},
    "upgrade-selection": {"input": ["inventory-slot0..3", "workbench-menu-select", "workbench-menu-exit", "primary-mouse-pressed"], "sends": ["exit-upgrade-menu"], "exits": {"craft-upgrade": "can afford (respond-to-upgrades-purchase-press--workbench)", "transition-to-weapons": "exit"}},
    "craft-upgrade": {"timing": "hold 0.75 s (2.5 s if workbench-object == workbench-fake-50)", "sends": ["craft-percent-thresh-passed at >= 80%", "stop-weapon-upgrade on cancel"], "exits": {"crafting-complete": "hold completed", "upgrade-selection": "hud2-cancel-crafting-action?"}},
    "crafting-complete": {"calls": ["player-weapon-upgrade-apply-bundle(player, weapon, upgrade)  <- gameplay grant (native)"], "sends": ["apply-upgrade-event(upgrade, weapon) -> world", "broadcast workbench-upgrade-purchased(workbench, upgrade, weapon)"], "exits": {"faded-out": "after signal workbench-notified"}},
    "faded-out": {"events": {"menu-fade-in": "-> setup-for-weapon-selection", "menu-fade-in-inspect": "-> inspect-weapon (no sender found)"}},
    "inspect-weapon": {"sends": ["workbench-menu-exit-inspect(false) on end"], "exits": {"setup-for-weapon-selection": "workbench-menu-exit input"}}
  }
}
