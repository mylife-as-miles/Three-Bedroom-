{
  "_about": "Interaction-station template distilled from the workbench (ss-t2/ss-workbench.bin + ss-hud2/ss-menu2-workbench.bin). Every 'uses' entry is a call observed in the workbench; kind = dc-script | native (functions.json kind != dc-script). This is a design spec for building NEW stations, not game data.",
  "station_data_def": {
    "description": "Data-drive the station like workbench-weapon-def: one record per 'variant' (weapon / tool / recipe) holding an anim-state-def per logical state plus phase constants and hook lambdas.",
    "anim_state_def": {
      "player": "workbench-anim-def (master clock)",
      "camera": "anim for dummy camera object (optional)",
      "props": ["display item", "item strap", "anim backpack", "parts object", "bench tools"],
      "hook": "script-lambda polled until true (side effects allowed)",
      "phases": ["event phase A (attach/show)", "event phase B (detach/hide)", "interrupt-allowed phase"]
    },
    "per_state_records": ["enter", "enter-light-variant map", "idle", "idle-alt + condition", "work (disassemble)", "work-idle (on table)", "apply (per-option, with combination map)", "un-work (assemble)", "swap-out (putback)", "swap-in (pullout)", "exit", "exit-light-variant map"],
    "interrupt_data": ["point-curve of interruptible phase ranges per state", "float-array of abort blend times", "point-curve mapping interrupted phase -> reverse-anim start phase"]
  },
  "building_blocks": [
    {"block": "availability gate", "uses": [["interactable-set-unavailable", "native"], ["interactable-enable/disable", "native"], ["tension-mode-is?", "dc-script"], ["npc-is-aware-of? / npc-get-awareness", "native"], ["get-player-carry-object-id", "native"], ["is-level-set-loaded?", "native"], ["interactable-camera-remap-force-active/inactive", "native"]], "pattern": "poll every 15 frames (nth-frame?) in wait-for-player / unavailable"},
    {"block": "prompt variant", "uses": [["override-interact-def(self, def)", "native"], ["interactable-set-exclude-from-pickup-scan", "native"]], "pattern": "swap to a '-with-<icon>' interactable def when an affordance exists (wrench icon = affordable upgrade)"},
    {"block": "entry trigger", "uses": [["event player-requested-interact", "native sender"], ["interactable-disable(self)", "native"]]},
    {"block": "persistence + discovery", "uses": [["get-svar-bit/set-svar-bit(<bitfield>, tag save-data-index)", "dc-script"], ["increment-stat", "native"], ["collectible-stat-objective-completed", "native"], ["start-timer (fires event named after timer)", "native"], ["fact-set(player, in-<station>, bool)", "native"]]},
    {"block": "prop/actor spawn", "uses": [["spawn-object(art, SimpleObject, get-spawner-locator(self,1), name, ...)", "native"], ["spawn-weapon-process(weapon, offset-locator(loc,(0,-5,0)), ...)", "native"], ["weapon-upgrade-apply-bundle(proc, bundle, 0)", "native"], ["use-wet-mask-id(proc, get-character-wet-mask-id(player))", "native"], ["set-visible / set-all-meshes-visible / set-mesh-visible", "native"], ["disable-collision / enable-collision", "native"]], "pattern": "spawn display copies hidden 5 m below the bench; reveal at anim phase"},
    {"block": "approach + align", "uses": [["wait-player-move-to-entry(enterAnim, apRefBoundFrame, 1, move-to-walk-settings, 0.40, apReference-camera1, apReference, ...)", "dc-script -> wait-player-scripted-move-new (native)"]], "pattern": "ap-ref = get-spawner-locator(self, 1) stored in a bound-frame declaration"},
    {"block": "weapon/hand prep", "uses": [["wait-holster-player-weapon / holster-player-weapon-physically", "native"], ["player-draw-weapon-by-name", "native"], ["event player-draw-weapon-done", "native sender"], ["player-stop-reload", "native"], ["player-set-weapon-partial-fade", "native"], ["holster-player-weapon(4, 1.0)", "native"]]},
    {"block": "input lock", "uses": [["joypad-disable-commands(flashlight-toggle, aim, move, weapon-cross, inventory-open, evade-start, evade-release, crouch-press, camera)", "native"], ["disable-interactable-system", "native"], ["player-disallow-reload/f, player-no-auto-reload", "native"], ["use-esc-for-back/f", "native"], ["gui2-disable-categories/f(16777216)", "native"], ["pause-all-hints", "native"], ["accessibility-suppress-control-sounds/f", "dc-script"]], "pattern": "re-issue every frame in each state's update block (per-frame /f style calls)"},
    {"block": "camera", "uses": [["spawn-camera(get-object-locator(player), name, 1)", "dc-script"], ["camera-enable-animated-with-id(id, blend, -1, 1, 1000, ...)", "native"], ["animate_(dummyCam, camAnim, {10: apRef, 85: id, ...})", "native"], ["camera-fade-out(id, 0.5, 0)", "native"], ["camera-enable-animated-stick(get-joint-locator(player, l_hand_prop), *stick-settings*, 0.5, 0.5, 1, 500, ...)", "native"], ["camera-fade-out-animated-stick(0.5)", "dc-script"], ["camera-fade-out-auto-gen(id, 2.0, 5.0, remap)", "native"], ["camera-shake(camera-mocap-idle-small, 1, 1, 1)", "dc-script"]]},
    {"block": "anim-phase sync (multi-actor)", "uses": [["animate_ / wait-animate_ with shared {10: apRef bound-frame, 58: get-animation-phase(player,1,anim), 28: blend}", "native"], ["signal(curr-state-updated) / wait-for(curr-state-updated)", "native"], ["wait-until-anim-phase(player, anim, phase, 2)", "dc-script"], ["object-anim-reached-phase?", "dc-script"], ["get-animation-phase / get-animation-duration / get-animation-frame", "native"], ["stop-animating(player, 1, 0.2, partialAnim, 0)", "native"]], "pattern": "write current anim-state into a global, signal, then N parallel tracks each wait-for the signal and act at their phase"},
    {"block": "interruptible animations", "uses": [["evaluate-point-curve(inverseCurve, get-animation-phase(...))", "native"], ["float-in-point-curve-range? (local helper)", "dc-script"]], "pattern": "queue the request, wait until phase is inside an allowed range, set use-inverse-phase, jump to the reverse state starting at the mapped phase with the per-range blend time"},
    {"block": "player rig swaps", "uses": [["player-swap-to-anim-backpack(0) / player-swap-to-cloth-backpack(0)", "native"], ["player-get-anim-backpack", "native"], ["set-player-global-boolean(anim-backpack-parenting / player-disable-backpack-sounds / allow-bolt-animate)", "native"], ["get-player-weapon-process-id-from-weapon-id", "native"], ["attach(proc, player, leftHand, 0) / detach-without-physicalizing", "native"]]},
    {"block": "screen / render / HUD hide", "uses": [["set-low-health-screen-effect-fade-request / clear-...", "native"], ["override-render-settings(*rs-...*, ...)", "native"], ["prioritize-texture-streaming-for(...)", "native"], ["hud2-hide-health-ammo/f", "native"]]},
    {"block": "menu open/close", "uses": [["hud2-push-menu-page(path) -> widget", "dc-script (menu2-show-page-stack, menu2-set-focus-to-page-stack, menu2-push-page)"], ["set-symbol(var, value, widget) / get-symbol(var, widget)", "native"], ["send-event(evt, widget)", "native"], ["menu2-hide-page-stack(hudMenuStack, 0) / menu2-show-page-stack", "native"], ["menu2-pop-page-and-all-above(hudMenuStack, path)", "native"], ["menu2-push-page / menu2-pop-page (null page as a 'hide' layer)", "native"]]},
    {"block": "menu-side purchase", "uses": [["joypad-command-active-and-enabled?(workbench-menu-select|exit|inspect-toggle, 2)", "native"], ["get-inventory-item-quantity(parts)", "dc-script"], ["lookup-weapon-upgrade-bundle-resources", "native"], ["hud2-cancel-crafting-action?", "dc-script"], ["gui2-set-progress-bar-percent / hud2-set-button-hold-percent", "native"], ["player-weapon-upgrade-apply-bundle(player, w, u)", "native"]]},
    {"block": "exit + cleanup", "uses": [["player-instant-draw-weapon-by-name(queued, 0, 1)", "native"], ["set-player-weapon-clip-ammo(get-total-ammo(w), w)", "native"], ["kill-entity / ddict-clear", "native"], ["remember-dynamic-checkpoint(1, 1, safeguard-stealth-checkpoint, delay)", "native"], ["broadcast-event(<station>-exited, self)", "native"], ["log-event", "native"]]}
  ],
  "lifecycle": ["initialize", "wait-for-player", "unavailable", "enter", "idle", "work states...", "exit", "wait-for-player"],
  "do_not_copy": ["single global *curr-workbench-state* (assumes one active station)", "decompiled timeouts of the form (get-current-time - get-current-time) > N are a dconstruct artefact; store the start time", "ss-workbench--weapon-swap-queued? decompiles to (s==1 && s==2) which is always false - treat as UNKNOWN"]
}
