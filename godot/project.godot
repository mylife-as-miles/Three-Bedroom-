; Engine configuration file for THREE BEDROOM (Godot 4.6.3 stable, Compatibility renderer).
; Hand-maintained; keep sections in Godot's order so editor saves produce small diffs.

config_version=5

[application]

config/name="THREE BEDROOM"
config/description="First-person night-time psychological horror. Browser runtime for the apartment built in Blender."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

TestBridge="*res://autoload/test_bridge.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

naming/default_signal_callback_name="_on_{node_name}_{signal_name}"

